# Binaries / build output
*.exe
*.dll
*.so
*.dylib
*.test
*.out
bin/
dist/
# Project built binaries (from go build ./cmd/...). Anchored to the repo root:
# unanchored these also match the cmd/server/ and cmd/scm-mcp/ source dirs,
# silently ignoring any new file added there.
/server
/scm-mcp

# Runtime user uploads (default ./uploads)
uploads/

# Assistant conversation history (JSONL, default ./data/assistant-memory)
data/

# Frontend
web/node_modules/
web/dist/

# Local dev database (schema auto-migrates on server start)
scm.db
*.db-journal

# Local secrets
.env

# Editor / tooling
.claude/
.qwen/
.DS_Store
.idea/
.vscode/

# local reverse proxy config (machine-specific)
Caddyfile

# runtime logs
logs/
